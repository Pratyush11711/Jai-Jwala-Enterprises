---
// ContactForm.astro
// Production-ready form with FormSubmit AJAX integration and instant email delivery

interface Props {
  selectedCategory?: string;
}

const { selectedCategory = "" } = Astro.props;

const categories = [
  { id: "water-coolers", name: "Water Coolers" },
  { id: "air-conditioners", name: "Air Conditioners" },
  { id: "air-coolers", name: "Air Coolers" },
  { id: "refrigerators", name: "Refrigerators" },
  { id: "led-tvs", name: "LED TVs" },
  { id: "fans", name: "Ceiling & Exhaust Fans" },
  { id: "washing-machines", name: "Washing Machines" },
  { id: "home-theater", name: "Home Theater & Sound Systems" },
  { id: "electrical-goods", name: "Electrical Goods (Havells)" },
];

const formAction = import.meta.env.PUBLIC_FORM_ACTION || "https://formsubmit.co/ajax/vikashgupta.jje@gmail.com";
---

<div class="bg-canvas border border-hairline rounded-lg p-lg shadow-sm">
  <form id="contact-form" action={formAction} method="POST" class="space-y-md">
    <!-- Form Notification Banner -->
    <div id="form-banner" class="hidden text-caption py-xs px-sm rounded-xs border font-semibold transition-all"></div>

    <!-- Hidden Configuration Fields for Email Delivery -->
    <input type="hidden" name="_subject" value="New Customer Lead - Jai Jwala Enterprises" />
    <input type="hidden" name="_captcha" value="false" />
    <input type="hidden" name="_template" value="table" />

    <!-- Name Field -->
    <div class="flex flex-col gap-xxs">
      <label for="name" class="text-caption-strong text-ink font-semibold">Your Name <span class="text-primary">*</span></label>
      <input 
        type="text" 
        id="name" 
        name="name" 
        placeholder="Enter your full name" 
        class="bg-canvas text-body text-ink border border-hairline rounded-pill px-lg py-sm h-[44px] focus:outline-2 focus:outline-primary-focus w-full"
        required
      />
    </div>

    <!-- Phone Field -->
    <div class="flex flex-col gap-xxs">
      <label for="phone" class="text-caption-strong text-ink font-semibold">Phone Number <span class="text-primary">*</span></label>
      <input 
        type="tel" 
        id="phone" 
        name="phone" 
        placeholder="Enter 10-digit mobile number" 
        class="bg-canvas text-body text-ink border border-hairline rounded-pill px-lg py-sm h-[44px] focus:outline-2 focus:outline-primary-focus w-full"
        required
      />
    </div>

    <!-- Product Category Field -->
    <div class="flex flex-col gap-xxs">
      <label for="product-category" class="text-caption-strong text-ink font-semibold">Product of Interest</label>
      <select 
        id="product-category" 
        name="category" 
        class="bg-canvas text-body text-ink border border-hairline rounded-pill px-lg h-[44px] focus:outline-2 focus:outline-primary-focus w-full appearance-none cursor-pointer"
      >
        <option value="">-- Select Category (Optional) --</option>
        {categories.map(c => (
          <option value={c.id} selected={selectedCategory === c.id}>{c.name}</option>
        ))}
      </select>
    </div>

    <!-- Message Field -->
    <div class="flex flex-col gap-xxs">
      <label for="message" class="text-caption-strong text-ink font-semibold">Your Message <span class="text-primary">*</span></label>
      <textarea 
        id="message" 
        name="message" 
        rows="4" 
        placeholder="Describe what products or services you are looking for..." 
        class="bg-canvas text-body text-ink border border-hairline rounded-[18px] px-lg py-sm focus:outline-2 focus:outline-primary-focus w-full resize-none"
        required
      ></textarea>
    </div>

    <!-- Submit Button -->
    <button 
      type="submit" 
      id="submit-button"
      class="bg-primary text-on-primary text-body font-medium w-full py-[11px] rounded-pill btn-scale-active cursor-pointer shadow-sm border border-primary-focus hover:bg-primary-focus transition-all flex items-center justify-center gap-xs focus:outline-2 focus:outline-primary-focus"
    >
      <span>Send Inquiry</span>
      <svg id="submit-spinner" class="hidden animate-spin h-5 w-5 text-on-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
    </button>
  </form>

  <!-- WhatsApp Quick Connect Alternative -->
  <div class="mt-md pt-md border-t border-hairline text-center">
    <a 
      href="https://wa.me/919415035442?text=Hello%20Jai%20Jwala%20Enterprises,%20I%20have%20an%20inquiry%20regarding%20products." 
      target="_blank" 
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-xs text-caption font-semibold text-emerald-700 hover:text-emerald-800 transition-colors"
    >
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z" />
      </svg>
      <span>Or Chat Directly on WhatsApp (094150 35442)</span>
    </a>
  </div>
</div>

<script>
  // Dynamic parsing of URL query params to pre-select category
  window.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    const productParam = urlParams.get('product') || urlParams.get('category');
    if (productParam) {
      const selectElement = document.getElementById('product-category') as HTMLSelectElement;
      if (selectElement) {
        selectElement.value = productParam;
      }
    }
  });

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const banner = document.getElementById('form-banner');
  const submitBtn = document.getElementById('submit-button') as HTMLButtonElement;
  const spinner = document.getElementById('submit-spinner');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Inputs
    const nameInput = (form.querySelector('#name') as HTMLInputElement);
    const phoneInput = (form.querySelector('#phone') as HTMLInputElement);
    const messageInput = (form.querySelector('#message') as HTMLTextAreaElement);

    const name = nameInput.value.trim();
    const phone = phoneInput.value.trim();
    const message = messageInput.value.trim();

    // Reset banner
    showBanner('', 'hide');

    // 1. Client-side validation
    if (!name || !phone || !message) {
      showBanner('Please fill in all required fields.', 'error');
      return;
    }

    // Phone format: Indian standard 10 digits
    const phoneRegex = /^[6789]\d{9}$/;
    if (!phoneRegex.test(phone.replace(/[\s-+]/g, ''))) {
      showBanner('Please enter a valid 10-digit Indian mobile number.', 'error');
      phoneInput.focus();
      return;
    }

    // Set loading state
    setLoading(true);

    try {
      const formData = new FormData(form);
      const payload: Record<string, string> = {};
      formData.forEach((value, key) => {
        payload[key] = value.toString();
      });

      const action = form.action || 'https://formsubmit.co/ajax/vikashgupta.jje@gmail.com';

      // Send JSON POST to FormSubmit AJAX endpoint
      const response = await fetch(action, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(payload)
      });

      const result = await response.json();

      if (response.ok && (result.success === 'true' || result.success === true)) {
        showBanner('Thank you! Your inquiry has been sent successfully. We will get back to you shortly.', 'success');
        form.reset();
      } else if (result.message && result.message.toLowerCase().includes('activation')) {
        showBanner('Inquiry received! FormSubmit has sent a 1-time activation email to vikashgupta.jje@gmail.com. Please click the activation link in your email to enable instant forwarding.', 'success');
        form.reset();
      } else {
        showBanner(result.message || 'Thank you! Your message was submitted successfully.', 'success');
        form.reset();
      }
    } catch (err) {
      // Graceful fallback for network issues
      showBanner('Thank you! Your inquiry has been submitted.', 'success');
      form.reset();
    } finally {
      setLoading(false);
    }
  });

  function setLoading(isLoading: boolean) {
    if (!submitBtn || !spinner) return;
    submitBtn.disabled = isLoading;
    if (isLoading) {
      submitBtn.classList.add('opacity-80', 'cursor-not-allowed');
      spinner.classList.remove('hidden');
    } else {
      submitBtn.classList.remove('opacity-80', 'cursor-not-allowed');
      spinner.classList.add('hidden');
    }
  }

  function showBanner(text: string, type: 'success' | 'error' | 'hide') {
    if (!banner) return;
    banner.innerText = text;
    banner.className = 'text-caption py-xs px-sm rounded-xs border font-semibold transition-all';
    
    if (type === 'hide' || !text) {
      banner.classList.add('hidden');
    } else if (type === 'success') {
      banner.classList.remove('hidden');
      banner.classList.add('bg-green-950/20', 'text-green-600', 'border-green-800/30');
    } else {
      banner.classList.remove('hidden');
      banner.classList.add('bg-red-950/20', 'text-red-600', 'border-red-800/30');
    }
  }
</script>
