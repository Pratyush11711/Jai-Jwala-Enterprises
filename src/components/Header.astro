---
// Header.astro
// Pinned global nav (44px) + sticky sub-nav (52px)

const products = [
  { name: "Water Coolers", href: "/products/water-coolers" },
  { name: "Air Conditioners", href: "/products/air-conditioners" },
  { name: "Air Coolers", href: "/products/air-coolers" },
  { name: "Refrigerators", href: "/products/refrigerators" },
  { name: "Home Theater & Sound", href: "/products/home-theater" },
  { name: "LED TVs", href: "/products/led-tvs" },
  { name: "Fans", href: "/products/fans" },
  { name: "Washing Machines", href: "/products/washing-machines" },
  { name: "Electrical Goods", href: "/products/electrical-goods" },
];
---

<header class="relative z-50">
  <!-- Pinned Global Nav: Black Bar (44px) -->
  <nav class="bg-surface-black h-[44px] flex items-center px-lg border-b border-white/10 select-none">
    <div class="max-w-[1440px] w-full mx-auto flex justify-between items-center">
      <!-- Logo Branding -->
      <a href="/" class="flex items-center focus:outline-2 focus:outline-primary-focus group">
        <div class="bg-canvas-parchment/90 backdrop-blur-sm rounded-md px-xs h-[32px] flex items-center justify-center border border-primary/20 shadow-sm transition-all hover:border-primary/40 hover:shadow-md">
          <img src="/logo.jpg" alt="Jai Jwala Logo" class="h-[22px] object-contain" />
        </div>
      </a>

      <!-- Desktop Links -->
      <div class="hidden md:flex gap-xl items-center text-nav-link text-body-on-dark uppercase relative group" id="nav-links">
        <a href="/" class="hover:text-primary transition-colors focus:outline-2 focus:outline-primary-focus">Home</a>
        <a href="/about" class="hover:text-primary transition-colors focus:outline-2 focus:outline-primary-focus">About</a>
        <div class="relative group">
          <button class="hover:text-primary transition-colors cursor-pointer flex items-center gap-xxs uppercase font-semibold text-[12px] focus:outline-2 focus:outline-primary-focus py-[12px] -mx-xs px-xs">
            Products
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3 h-3 transition-transform group-hover:rotate-180">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
            </svg>
          </button>
          
          <!-- Dropdown List - positioned at bottom of 44px nav bar -->
          <div class="absolute top-full left-1/2 -translate-x-1/2 hidden group-hover:flex flex-col bg-surface-black border border-white/10 rounded-b-sm rounded-t-none p-xs w-[200px] z-50 shadow-lg before:content-[''] before:absolute before:top-[-4px] before:left-0 before:right-0 before:h-4 before:bg-transparent">
            {products.map(p => (
              <a href={p.href} class="px-sm py-xxs hover:bg-white/5 hover:text-primary rounded-xs transition-all text-nav-link text-body-on-dark lowercase first-letter:uppercase">
                {p.name}
              </a>
            ))}
          </div>
        </div>
        <a href="/reviews" class="hover:text-primary transition-colors focus:outline-2 focus:outline-primary-focus">Reviews</a>
        <a href="/contact" class="hover:text-primary transition-colors focus:outline-2 focus:outline-primary-focus">Contact</a>
      </div>

      <!-- Hamburger Button (Mobile) -->
      <button id="menu-toggle" aria-label="Toggle Menu" class="md:hidden text-body-on-dark hover:text-primary cursor-pointer focus:outline-2 focus:outline-primary-focus">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Sticky Sub-Nav (52px): Frosted Parchment -->
  <div class="sticky top-0 bg-canvas-parchment/80 backdrop-blur-md h-[52px] flex items-center px-lg border-b border-hairline select-none shadow-sm">
    <div class="max-w-[1440px] w-full mx-auto flex justify-between items-center">
      <!-- Title -->
      <span class="text-tagline text-ink font-semibold tracking-wider font-display">
        <span class="inline sm:hidden">Jai Jwala</span>
        <span class="hidden sm:inline">Jai Jwala Enterprises</span>
      </span>

      <!-- Sub Links & Action -->
      <div class="flex items-center gap-lg">
        <a href="/contact" class="hidden sm:inline-block text-button-utility hover:text-primary transition-colors font-medium text-ink focus:outline-2 focus:outline-primary-focus">Inquire Now</a>
        <a href="tel:09415035442" class="bg-primary text-on-primary font-medium text-caption rounded-pill px-md py-[8px] sm:px-[22px] sm:py-[11px] btn-scale-active shadow-sm border border-primary-focus hover:bg-primary-focus transition-all flex items-center gap-xs focus:outline-2 focus:outline-primary-focus whitespace-nowrap">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
          </svg>
          094150 35442
        </a>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Overlay -->
  <div id="mobile-drawer" class="fixed inset-0 top-[44px] bg-surface-black z-40 hidden flex-col p-lg select-none">
    <div class="flex flex-col gap-lg text-[20px] font-semibold text-body-on-dark">
      <a href="/" class="hover:text-primary transition-colors py-xxs border-b border-white/5">Home</a>
      <a href="/about" class="hover:text-primary transition-colors py-xxs border-b border-white/5">About</a>
      <div class="flex flex-col py-xxs border-b border-white/5">
        <span class="text-body-muted text-xs uppercase mb-xxs">Our Products</span>
        <div class="grid grid-cols-2 gap-sm pl-sm">
          {products.map(p => (
            <a href={p.href} class="hover:text-primary text-[14px] font-medium leading-relaxed">
              {p.name}
            </a>
          ))}
        </div>
      </div>
      <a href="/reviews" class="hover:text-primary transition-colors py-xxs border-b border-white/5">Reviews</a>
      <a href="/contact" class="hover:text-primary transition-colors py-xxs border-b border-white/5">Contact</a>
    </div>
  </div>
</header>

<script>
  // Mobile drawer toggle script
  const toggleBtn = document.getElementById('menu-toggle');
  const drawer = document.getElementById('mobile-drawer');
  const iconPath = document.getElementById('menu-icon');

  const hamburgerIcon = "M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5";
  const closeIcon = "M6 18L18 6M6 6l12 12";

  toggleBtn?.addEventListener('click', () => {
    const isHidden = drawer?.classList.contains('hidden');
    
    if (isHidden) {
      drawer?.classList.remove('hidden');
      drawer?.classList.add('flex');
      iconPath?.setAttribute('d', closeIcon);
      document.body.style.overflow = 'hidden'; // Lock scrolling
    } else {
      drawer?.classList.remove('flex');
      drawer?.classList.add('hidden');
      iconPath?.setAttribute('d', hamburgerIcon);
      document.body.style.overflow = ''; // Unlock scrolling
    }
  });

  // Close drawer on link click
  const drawerLinks = drawer?.querySelectorAll('a');
  drawerLinks?.forEach(link => {
    link.addEventListener('click', () => {
      drawer?.classList.remove('flex');
      drawer?.classList.add('hidden');
      iconPath?.setAttribute('d', hamburgerIcon);
      document.body.style.overflow = '';
    });
  });
</script>
